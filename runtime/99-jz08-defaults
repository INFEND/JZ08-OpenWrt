#!/bin/sh
# Runs only inside the external RAM rootfs; OEM block devices are read-only.
set -e
uci set system.@system[0].hostname='INFEND-JZ08'
uci set luci.main.lang='ru'
uci -q delete network.modem || true
uci -q batch <<'EOF'
set network.loopback=interface
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'
set network.lan=interface
set network.lan.device='usb0'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.73.1'
set network.lan.netmask='255.255.255.0'
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='10'
set dhcp.lan.limit='10'
set dhcp.lan.leasetime='1h'
commit
EOF
if [ -s /etc/jz08-password ]; then
    password="$(cat /etc/jz08-password)"
    printf '%s\n%s\n' "$password" "$password" | /bin/busybox passwd root
    rm -f /etc/jz08-password
fi
exit 0
